rules_version = '2';

// Meerstraat wines: who may read and change what.
// Paste this in Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function cellar(c) { return get(/databases/$(database)/documents/cellars/$(c)).data; }
    function isMember(c) { return signedIn() && me() in cellar(c).memberIds; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // A profile per person (name, e-mail, taste, what they have seen): only they can read and change it.
    // Names of the people in a cellar come from the cellar itself (members).
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // To be found for a tip: your name under your own e-mail address. Whoever knows the exact address
    // can look it up (get); nobody can list them all.
    match /emails/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email
        && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /cellars/{c} {
      // Only members see a cellar.
      allow read: if signedIn() && me() in resource.data.memberIds;

      // Anyone signed in can start a cellar of their own.
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.memberIds == [me()];

      allow update: if signedIn() && (
        // the owner may rename and manage members, but cannot hand the cellar away or drop themselves
        (me() == resource.data.owner
          && request.resource.data.owner == resource.data.owner
          && me() in request.resource.data.memberIds)
        // a member may leave
        || (me() in resource.data.memberIds && me() != resource.data.owner
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([me()])
          && changes().hasOnly(['memberIds', 'members']))
        // someone with a valid invite for this cellar may join (only adding themselves)
        || (!(me() in resource.data.memberIds)
          && request.resource.data.memberIds == resource.data.memberIds.concat([me()])
          && changes().hasOnly(['memberIds', 'members', 'lastJoin'])
          && request.resource.data.lastJoin.uid == me()
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.lastJoin.code))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoin.code)).data.cellarId == c
          && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoin.code)).data.expiresAt > request.time)
      );

      allow delete: if signedIn() && me() == resource.data.owner;

      // The wines: every member may read them. Only the owner adds, changes or removes wines,
      // unless the owner switched on "membersEdit" for this cellar (Settings → Deze kelder).
      // Every member may give a wine their own score (scores.<their id>), also when they cannot edit wines.
      match /wines/{wine} {
        allow read: if isMember(c);
        allow write: if isMember(c) && (cellar(c).owner == me() || cellar(c).get('membersEdit', false) == true);
        allow update: if isMember(c)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores'])
          && request.resource.data.get('scores', {}).diff(resource.data.get('scores', {})).affectedKeys().hasOnly([me()]);
      }
    }

    // Invite links: made by a member, readable by whoever signs in with the code.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.by == me()
        && isMember(request.resource.data.cellarId);
      allow delete: if signedIn() && resource.data.by == me();
    }

    // Tips: recommend a wine to someone, with a short message. The sender writes it; only the sender
    // and the receiver can read it; the receiver's app puts the wine on their wish list and removes the tip.
    match /tips/{t} {
      allow create: if signedIn()
        && request.resource.data.from.uid == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.keys().hasOnly(['from', 'to', 'toName', 'message', 'wine', 'createdAt']);
      allow read: if signedIn() && (resource.data.to == me() || resource.data.from.uid == me());
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from.uid == me());
    }

    // Events: a get-together you organise. The owner adds people; every member brings wines.
    // Each wine is a copy taken from someone's cellar, so all members can read it
    // without getting access to that cellar.
    function event(e) { return get(/databases/$(database)/documents/events/$(e)).data; }
    function inEvent(e) { return signedIn() && me() in event(e).memberIds; }

    match /events/{e} {
      allow read: if signedIn() && me() in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.memberIds == [me()];

      allow update: if signedIn() && (
        // the owner may edit the event and add or remove people, but stays owner and member
        (me() == resource.data.owner
          && request.resource.data.owner == resource.data.owner
          && me() in request.resource.data.memberIds)
        // a member may leave
        || (me() in resource.data.memberIds && me() != resource.data.owner
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([me()])
          && changes().hasOnly(['memberIds', 'members']))
        // someone with a valid event invite may join (only adding themselves)
        || (!(me() in resource.data.memberIds)
          && request.resource.data.memberIds == resource.data.memberIds.concat([me()])
          && changes().hasOnly(['memberIds', 'members', 'lastJoin'])
          && request.resource.data.lastJoin.uid == me()
          && exists(/databases/$(database)/documents/eventInvites/$(request.resource.data.lastJoin.code))
          && get(/databases/$(database)/documents/eventInvites/$(request.resource.data.lastJoin.code)).data.eventId == e
          && get(/databases/$(database)/documents/eventInvites/$(request.resource.data.lastJoin.code)).data.expiresAt > request.time)
      );

      allow delete: if signedIn() && me() == resource.data.owner;

      // The wines for the event: every member reads them; you add and change only your own;
      // the owner may also remove any wine (and clears them all when deleting the event).
      match /wines/{w} {
        allow read: if inEvent(e);
        allow create: if inEvent(e) && request.resource.data.addedBy.uid == me();
        allow update: if inEvent(e) && resource.data.addedBy.uid == me() && request.resource.data.addedBy.uid == me();
        allow delete: if inEvent(e) && (resource.data.addedBy.uid == me() || event(e).owner == me());
      }
    }

    // Invite links for events: made by the event owner, readable by whoever signs in with the code.
    match /eventInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.by == me()
        && event(request.resource.data.eventId).owner == me();
      allow delete: if signedIn() && resource.data.by == me();
    }

    // Usage counts for the app's builder (admin.js): one record per person, with counts only.
    // You write only your own record, with a fixed set of fields; only an admin reads them all.
    // An admin is whoever has a document admins/{their uid}, made by hand in the Firebase console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }

    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
    }

    match /stats/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'first', 'last', 'day', 'opens', 'daysTotal', 'days',
             'cellars', 'wines', 'scored', 'ai', 'aiTotal'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
    }
  }
}
